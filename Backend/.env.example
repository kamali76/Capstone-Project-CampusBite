# --- Database ---------------------------------------------------------------
# SQLite file. (docker-compose overrides this with the in-container path.)
DATABASE_URL=sqlite:///./data/campusbite.db

# --- Security ---------------------------------------------------------------
# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Background reminders ---------------------------------------------------
ENABLE_BACKGROUND_TASKS=true
REMINDER_AFTER_MINUTES=15
REMINDER_INTERVAL_SECONDS=60

# --- Demo data (restaurants, menus and demo accounts on first start) ---------
SEED_DEMO_DATA=true
# Optional: password for the demo accounts. Leave blank to use the default
# documented in the README.
SEED_DEMO_PASSWORD=

# --- AI order insights (OpenAI) ----------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
